---
import Base from '../layouts/Base.astro';
import AdminStats from '../components/AdminStats.tsx';
import '../styles/pages.css';
import '../styles/admin.css';

/*
 * Private dashboard. Three things keep it private, and only the first is real
 * security:
 *
 *  1. A Cloudflare Access application covers nargesmirheydari.com/admin*, so
 *     the request is challenged at the edge and only my email gets through.
 *     This page and its data API are both under that path, deliberately.
 *  2. noindex, so it never turns up in a search result.
 *  3. It is absent from the nav and the footer.
 *
 * Worth being clear-eyed about 2 and 3: they are tidiness, not protection. The
 * HTML is a static file on GitHub Pages, and anyone who reached the origin
 * directly could read it. What they could *not* do is see any numbers, those
 * only exist behind the Worker, which verifies the Access token itself rather
 * than trusting that the edge already did.
 */
---

<Base title="Visits, admin" noindex>
  <div class="reading col-900">
    <p class="breadcrumb mono">ADMIN · PRIVATE</p>
    <h1 class="page-h1">Who’s been visiting</h1>

    <p class="lede">
      Traffic to nargesmirheydari.com, measured by Cloudflare Web Analytics.
      Only you can open this page.
    </p>

    <AdminStats client:load />

    <p class="admin-note">
      <strong>What “visits” means here.</strong> A visit is someone arriving at
      the site; a page view is any page opened, so one visitor reading four
      pages is one visit and four page views. Nobody is followed between
      sessions and no cookie is set, so a person returning next week counts as a
      new visit, the number answers “how often was the site opened”, not “how
      many distinct humans exist”.
    </p>
  </div>
</Base>
