---
import { primaryNav, routes } from '../lib/routes';
import ThemeSwitch from './ThemeSwitch.tsx';

interface Props {
  current?: 'works' | 'about' | 'design';
}

const { current } = Astro.props;
---

<header class="site-header">
  {/* The wordmark is a second route home, so it is a link, not a heading.
      aria-current stays on the nav's Works item rather than being duplicated
      here, two "current page" markers would be noise, not information. */}
  <a class="wordmark" href={routes.works}>Narges Mirheydari</a>

  <div class="header-right">
    <nav class="site-nav" aria-label="Primary">
      {
        primaryNav.map((item) => (
          <a
            href={item.href}
            aria-current={current === item.key ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <ThemeSwitch client:load />
  </div>
</header>
