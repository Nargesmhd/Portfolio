---
import Base from '../layouts/Base.astro';
import RotatingWord from '../components/RotatingWord.tsx';
import Marquee from '../components/Marquee.tsx';
import FolderStack from '../components/FolderStack.tsx';
import { folders } from '../data/folders';
import AboutAccordion from '../components/AboutAccordion.tsx';
import { url } from '../lib/routes';
import '../styles/home.css';
---

<Base title="Works, Narges Mirheydari" current="works">
  <div class="home">
    <div class="masthead">
      {/* The heading right below already says who this is, so the alt text
          skips her name and carries the part no other text mentions: she is
          not alone in the picture. */}
      <img
        class="portrait"
        src={url('/portrait.jpg')}
        alt="Narges in a car with her dog."
        width="160"
        height="160"
        decoding="async"
      />
      <div class="masthead-text">
        <h1>Hi, I am Narges.</h1>

        <p class="intro">
          A product designer in Toronto. I use behavioural research and WCAG
          standards to build things that work for everyone, including the
          people most products forget.
        </p>
      </div>
    </div>

    <RotatingWord client:load />

    <div class="scroll-cue mono" aria-hidden="true">
      SCROLL<span>↓</span>
    </div>

    <Marquee client:load />

    <FolderStack
      client:load
      items={folders}
      caption="four folders, stacked. open one to see what is inside."
      label="Work folders"
    />

    <AboutAccordion client:load />
  </div>
</Base>
