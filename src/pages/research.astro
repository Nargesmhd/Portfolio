---
import Base from '../layouts/Base.astro';
import FolderStack, { type FolderItem } from '../components/FolderStack.tsx';
import { projectsOf } from '../data/projects';
import { projectUrl, routes } from '../lib/routes';
import '../styles/pages.css';
import '../styles/home.css';

/*
 * The visual side of a project, number, colour, tab position, is decided
 * here rather than in the data, so the file Narges edits stays about the work.
 * Tones alternate and offsets step by 172px, the same staircase the home
 * stack uses, however many projects there are.
 */
const TONES = ['var(--f3)', 'var(--f2)'];

const items: FolderItem[] = projectsOf('research').map((p, i) => ({
  key: p.slug,
  num: String(i + 1).padStart(2, '0'),
  title: p.title,
  description: p.summary,
  contents: p.contents,
  cta: p.draft ? 'Read the draft →' : 'Open the case study →',
  href: projectUrl(p.slug),
  tone: TONES[i % TONES.length],
  tabOffset: i * 172,
  badge: p.draft ? 'DRAFT' : undefined,
}));
---

<Base
  title="Research, Narges Mirheydari"
  description="UX research on the people products forget, starting with where phones fail bilingual adults with dyslexia."
  current="works"
>
  <div class="home">
    <p class="breadcrumb mono">
      <a href={routes.works}>works</a> / research
    </p>

    <h1 class="page-h1">Research</h1>

    <p class="lede">
      Research into the people products forget, done before anything gets
      designed: what the evidence says, what it does not, and the study that
      would close the gap. Open a folder to read each one.
    </p>

    <FolderStack
      client:load
      items={items}
      caption="one folder per study. open one to read the case study."
      label="Research studies"
    />

    <nav class="page-nav mono" aria-label="Research">
      <a href={routes.works}>← back to folders</a>
      <a href={routes.design}>how I design →</a>
    </nav>
  </div>
</Base>
