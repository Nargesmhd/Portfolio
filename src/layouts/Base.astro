---
import '@fontsource-variable/newsreader';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource-variable/caveat';
import '../styles/global.css';

import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ReadingRail from '../components/ReadingRail.tsx';
import { url } from '../lib/routes';
import { cardAlt, cardFile, cardFor, cardLayout } from '../lib/share';

interface Props {
  title: string;
  description?: string;
  /** Which nav item gets aria-current="page". Omit on pages outside the nav. */
  current?: 'works' | 'about' | 'design';
  /**
   * Keeps the page out of search results *and* out of its own analytics.
   * The two belong together: a page nobody should find yet is also a page
   * whose views would tell me nothing, and counting them would corrupt the
   * very numbers the admin page exists to report.
   *
   * Set on the admin page, which is private, and on draft case studies,
   * which are reachable but not finished.
   */
  noindex?: boolean;
}

const {
  title,
  description = 'Product designer in Toronto. Behavioural research and WCAG standards, applied to things that work for everyone.',
  current,
  noindex = false,
} = Astro.props;

/*
 * Cloudflare Web Analytics. The token is a public, write-only site tag, it is
 * meant to ship in the page, and it grants no read access to the numbers. The
 * reading side is the Worker behind Cloudflare Access; nothing here can be used
 * to see the data.
 *
 * Unset means no beacon at all, so local dev and previews never pollute the
 * real counts. See docs/analytics.md for where the value comes from.
 */
const beaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
const beacon = !noindex && beaconToken ? beaconToken : null;

/*
 * Link preview. Absolute URLs throughout: a pasted link is unfurled by a
 * server somewhere else, which has no page to resolve a relative path against
 * and will simply drop the image.
 *
 * The card itself is a committed picture drawn by `npm run share-cards`; the
 * text below comes from the same entry, so the preview and the page always
 * say the same thing. See src/lib/share.ts.
 */
const card = cardFor(Astro.url.pathname);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const shareImage = new URL(`/og/${cardFile(card.path)}.png`, Astro.site).href;
const shareSize = {
  width: String(cardLayout.width * cardLayout.scale),
  height: String(cardLayout.height * cardLayout.scale),
};
---

<!doctype html>
<html lang="en" data-theme="light" data-palette="sky">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />

    {/*
      Open Graph is what Slack, LinkedIn, iMessage and the rest read; the
      twitter:card line is the one extra tag that makes them show the picture
      full-width instead of as a thumbnail. og:image:alt is not decoration -
      several clients read it out, and it is the only description a person
      using a screen reader gets of the card.
    */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Narges Mirheydari" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content={shareSize.width} />
    <meta property="og:image:height" content={shareSize.height} />
    <meta property="og:image:alt" content={cardAlt(card)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={cardAlt(card)} />

    {
      /*
        Deferred so it never competes with first paint, and cookie-less by
        design, it stores nothing on the visitor's machine, which is why the
        site needs no cookie banner.
      */
      beacon && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: beacon })}
        />
      )
    }

    {/*
      Runs before first paint so the saved theme and reading settings are
      already on <html> when the page renders. Without this the page would
      flash the default light theme before React hydrated, which is worst
      for exactly the users these settings exist for.
    */}
    <script is:inline>
      (function () {
        var el = document.documentElement;
        var p = {};
        try {
          p = JSON.parse(localStorage.getItem('nm-prefs') || '{}') || {};
        } catch (e) {
          p = {};
        }
        var theme =
          p.theme ||
          (window.matchMedia &&
          window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light');
        el.dataset.theme = theme;
        el.dataset.palette = p.palette || 'sky';
        if (p.largerText) el.dataset.text = 'large';
        if (p.highContrast) el.dataset.contrast = 'high';
        if (p.plain) el.dataset.plain = 'on';
      })();
    </script>
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <SiteHeader current={current} />

    <ReadingRail client:load />

    <main id="main" class="shell page-enter" tabindex="-1">
      <slot />
    </main>

    <SiteFooter />

    <style>
      /* Off-screen until focused, then pinned top-left. Kept in the layout
         because it must be the first focusable element in the document. */
      /* The handoff specifies 12px/18px padding, which lands at 37px tall -
         under the 44px minimum the site claims. Kept the visual padding and
         set an explicit min-height so the target actually meets the claim. */
      .skip {
        position: absolute;
        left: 12px;
        top: -60px;
        z-index: 20;
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        background: var(--ink);
        color: var(--bg);
        padding: 12px 18px;
        font: 500 13px/1 var(--font-mono);
        text-decoration: none;
      }

      .skip:focus {
        top: 12px;
      }

      /* main is focusable only as the skip-link target, never a tab stop. */
      main:focus {
        outline: none;
      }
    </style>
  </body>
</html>
